--// Crosshair Controls

local function SetCrosshairSize(Value)
    CrosshairSize = math.clamp(math.floor(Value + 0.5), 1, 100)
    Crosshair.Size = UDim2.fromOffset(CrosshairSize, CrosshairSize)
end

local function SetSpinSpeed(Value)
    SpinSpeed = math.clamp(math.floor(Value + 0.5), 1, 500)
end

local function CreateControl(TitleText, Y, Minimum, Maximum, InitialValue, Step, Callback)
    local Container = New("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, Y),
        Size = UDim2.new(1, -24, 0, 58),
        ZIndex = 32
    }, Menu)

    local NameLabel = Label(
        Container,
        TitleText,
        UDim2.fromOffset(0, 0),
        UDim2.new(1, -45, 0, 17),
        11,
        White
    )
    NameLabel.ZIndex = 33

    local ValueLabel = New("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(45, 17),
        Font = Enum.Font.GothamMedium,
        TextColor3 = Muted,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 33
    }, Container)

    local Minus = New("TextButton", {
        Position = UDim2.fromOffset(0, 25),
        Size = UDim2.fromOffset(24, 21),
        BackgroundColor3 = Surface2,
        Text = "−",
        TextColor3 = White,
        TextSize = 16,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
        ZIndex = 34
    }, Container)
    Corner(Minus, 5)

    local Plus = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 25),
        Size = UDim2.fromOffset(24, 21),
        BackgroundColor3 = Surface2,
        Text = "+",
        TextColor3 = White,
        TextSize = 15,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
        ZIndex = 34
    }, Container)
    Corner(Plus, 5)

    local Track = New("Frame", {
        Position = UDim2.fromOffset(30, 32),
        Size = UDim2.new(1, -60, 0, 7),
        BackgroundColor3 = Surface2,
        BorderSizePixel = 0,
        ZIndex = 33
    }, Container)
    Corner(Track, 5)

    local Fill = New("Frame", {
        Size = UDim2.fromScale(
            (InitialValue - Minimum) / (Maximum - Minimum),
            1
        ),
        BackgroundColor3 = White,
        BorderSizePixel = 0,
        ZIndex = 34
    }, Track)
    Corner(Fill, 5)

    local CurrentValue = InitialValue

    local function Update(Value)
        CurrentValue = math.clamp(
            math.floor(Value + 0.5),
            Minimum,
            Maximum
        )

        Fill.Size = UDim2.fromScale(
            (CurrentValue - Minimum) / (Maximum - Minimum),
            1
        )

        ValueLabel.Text = tostring(CurrentValue)
        Callback(CurrentValue)
    end

    local function UpdateFromX(X)
        local Width = Track.AbsoluteSize.X
        if Width <= 0 then
            return
        end

        local Alpha = math.clamp(
            (X - Track.AbsolutePosition.X) / Width,
            0,
            1
        )

        Update(Minimum + Alpha * (Maximum - Minimum))
    end

    Connect(Track.InputBegan, function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then

            SliderState = {
                UpdateFromX = UpdateFromX,
                InputType = Input.UserInputType,
                Input = Input
            }

            local X = Input.Position.X
            if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                X = UserInputService:GetMouseLocation().X
            end

            UpdateFromX(X)
        end
    end)

    Connect(Minus.Activated, function()
        Update(CurrentValue - Step)
    end)

    Connect(Plus.Activated, function()
        Update(CurrentValue + Step)
    end)

    Update(InitialValue)
end

