--// Dragging

local function BeginDrag(Input, Kind, Object)
    if Input.UserInputType ~= Enum.UserInputType.MouseButton1
        and Input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    DragState = {
        Kind = Kind,
        Object = Object,
        Input = Input,
        InputType = Input.UserInputType,
        StartPointer = Vector2.new(Input.Position.X, Input.Position.Y),
        StartPosition = Object.Position,
        Moved = false
    }
end

Connect(Launcher.InputBegan, function(Input)
    BeginDrag(Input, "Launcher", Launcher)
end)

Connect(Header.InputBegan, function(Input)
    BeginDrag(Input, "Menu", Menu)
end)

Connect(UserInputService.InputChanged, function(Input)
    if SliderState then
        if SliderState.InputType == Enum.UserInputType.MouseButton1
            and Input.UserInputType == Enum.UserInputType.MouseMovement then
            SliderState.UpdateFromX(UserInputService:GetMouseLocation().X)
        elseif SliderState.InputType == Enum.UserInputType.Touch
            and Input.UserInputType == Enum.UserInputType.Touch
            and Input == SliderState.Input then
            SliderState.UpdateFromX(Input.Position.X)
        end
    end

    if not DragState then
        return
    end

    local IsMouseMove =
        DragState.InputType == Enum.UserInputType.MouseButton1
        and Input.UserInputType == Enum.UserInputType.MouseMovement

    local IsTouchMove =
        DragState.InputType == Enum.UserInputType.Touch
        and Input.UserInputType == Enum.UserInputType.Touch
        and Input == DragState.Input

    if not IsMouseMove and not IsTouchMove then
        return
    end

    local Pointer

    if IsMouseMove then
        Pointer = UserInputService:GetMouseLocation()
    else
        Pointer = Vector2.new(Input.Position.X, Input.Position.Y)
    end

    local Delta = Pointer - DragState.StartPointer

    if Delta.Magnitude > 4 then
        DragState.Moved = true
    end

    local Object = DragState.Object
    local StartPosition = DragState.StartPosition

    Object.Position = UDim2.new(
        StartPosition.X.Scale,
        StartPosition.X.Offset + Delta.X,
        StartPosition.Y.Scale,
        StartPosition.Y.Offset + Delta.Y
    )
end)

Connect(UserInputService.InputEnded, function(Input)
    if SliderState then
        local SliderFinished =
            (SliderState.InputType == Enum.UserInputType.MouseButton1
                and Input.UserInputType == Enum.UserInputType.MouseButton1)
            or (SliderState.InputType == Enum.UserInputType.Touch
                and Input == SliderState.Input)

        if SliderFinished then
            SliderState = nil
        end
    end

    if not DragState then
        return
    end

    local DragFinished =
        (DragState.InputType == Enum.UserInputType.MouseButton1
            and Input.UserInputType == Enum.UserInputType.MouseButton1)
        or (DragState.InputType == Enum.UserInputType.Touch
            and Input == DragState.Input)

    if not DragFinished then
        return
    end

    local WasLauncher = DragState.Kind == "Launcher"
    local WasMoved = DragState.Moved

    DragState = nil

    if WasLauncher and not WasMoved then
        ToggleMenu()
    end
end)

--// Hide Matching PlayerGui Crosshairs

local function IsNativeCrosshair(Object)
    if not Object:IsA("GuiObject") or Object:IsDescendantOf(Gui) then
        return false
    end

    local Name = string.lower(Object.Name)

    return string.find(Name, "crosshair", 1, true) ~= nil
        or string.find(Name, "reticle", 1, true) ~= nil
        or string.find(Name, "aimdot", 1, true) ~= nil
        or string.find(Name, "cross", 1, true) ~= nil
end

local function HideNative(Object)
    if not IsNativeCrosshair(Object) then
        return
    end

    if HiddenObjects[Object] == nil then
        HiddenObjects[Object] = Object.Visible
        table.insert(NativeObjects, Object)
    end

    Object.Visible = false
end

for _, Object in ipairs(PlayerGui:GetDescendants()) do
    HideNative(Object)
end

Connect(PlayerGui.DescendantAdded, function(Object)
    task.defer(function()
        if Alive and Gui.Parent then
            HideNative(Object)
        end
    end)
end)

--// Optimized Update

local Connection

Connection = RunService.RenderStepped:Connect(function(DeltaTime)
    if not Alive or not Gui.Parent then
        Connection:Disconnect()
        return
    end

    CheckTimer += DeltaTime

    if CheckTimer >= 0.15 then
        CheckTimer = 0

        LastShiftLock =
            UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter

        if Crosshair.Visible ~= LastShiftLock then
            Crosshair.Visible = LastShiftLock
        end
    end

    if LastShiftLock and Crosshair.Visible and SpinSpeed > 0 then
        Rotation = (Rotation + SpinSpeed * DeltaTime) % 360
        Crosshair.Rotation = Rotation
    end

    NativeScanTimer += DeltaTime

    if NativeScanTimer >= 1 then
        NativeScanTimer = 0

        for Index = #NativeObjects, 1, -1 do
            local Object = NativeObjects[Index]

            if not Object.Parent then
                HiddenObjects[Object] = nil
                table.remove(NativeObjects, Index)
            elseif Object.Visible then
                Object.Visible = false
            end
        end
    end
end)

--// Shared Cleanup

_G[CLEANUP_NAME] = function()
    if not Alive then
        return
    end

    Alive = false

    for _, ConnectionObject in ipairs(Connections) do
        pcall(function()
            ConnectionObject:Disconnect()
        end)
    end

    pcall(function()
        Connection:Disconnect()
    end)

    for Object, WasVisible in pairs(HiddenObjects) do
        pcall(function()
            if Object.Parent then
                Object.Visible = WasVisible
            end
        end)
    end

    if Gui.Parent then
        Gui:Destroy()
    end

    if _G[CLEANUP_NAME] then
        _G[CLEANUP_NAME] = nil
    end
end
